		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Service_Request_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "vehicle service booking : New entry added"
							message : "<div>Hello,<br><br>A new entry added in 'Service_Request_Form' form of vehicle service booking application.<br></div>"
						)
					}
				}
			}
			On_ServiceRequest_Submit_ as "On_ServiceRequest_Submit_Workflow"
			{
				type =  form
				form = Service_Request_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Record Added${Service_Request_ID}"
							message : "<div>${zoho.loginuserid} has added a record in form Vehicle Service &amp; Repair Request Management<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_ServiceDate_Reminde as "Daily_ServiceDate_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 18:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
				}
			}
		}

		approval
		{
			HighCost_Repair_Approval as "HighCost_Repair_Approval"
			{
				type =  approval
				form = Service_Request_Form[Estimated_Service_Cost > 5000]
				display fields = [Owner_Name,Email_Address,Pickup_Address,Contact_Number,Vehicle_Registration_Number,Issue_Description,Odometer_Reading]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : "zoho.loginuserid"
								subject : "${Estimated_Service_Cost}"
								message : "<div>the high-cost repair estimate has been approved and that work will proceed.<br></div>"
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
							sendmail
							(
								from : "zoho.adminuserid"
								to : Email_Address
								subject : "${Estimated_Service_Cost}"
								message : "<div>Rejected</div>"
							)
						}
					}
				}
			}
		}

		blueprint
		{
    			Service_Lifecycle_Bluepri as "Service_Lifecycle_Blueprint"
    			{
        			type = Blueprint
