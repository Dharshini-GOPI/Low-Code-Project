/*
 * Author       : dharshini.g1.2024.cse_raj
 * Generated on : 10-Nov-2026 08:51:29
 * Version      : 1.0
 */
 application "vehicle service booking"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Service_Request_Form
		{
			displayname = "Vehicle Service & Repair Request Management"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Owner_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Pickup_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Vehicle_Registration_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Odometer_Reading
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Service_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Dropoff_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vehicle_Type
			(
				type = picklist
				maxchar = 100
				values = {"Hatchback Car","Sedan","SUV","Light Commercial Vehicle (LCV)","Electric Vehicle (EV)","Heavy Truck","Trailer"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"General Service","Engine Repair","Transmission Repair","Suspension Repair","Wheel Balancing","Battery Replacement","Radiator/Cooling System Service"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Services_Requested
			(
				type = list	
				values = {"Oil Level Check","Tyre Pressure Check","Wheel Alignment Check","Brake Noise Check","Engine Noise Inspection","Coolant Top-Up"}
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Authorize_Estimate_And_Repair
			(
				type = checkboxes	
				values = {"checked(agreed)","checked(disgree)","Notchecked"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Pickup_Drop_Service
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Center_Guidelines_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Insurance_Policy_Portal_URL
			(
    			type = url
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vehicle_Damage_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Discount_Percent
			(
    			type = percentage
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Service_Cost
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vehicle_Age_Years
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Request_Submitted_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Previous_Service_History
			(
				type = grid
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Vehicle_Model_Lookup
			(
				type = picklist	
				values  = Service_Request_Form.ID
    			displayformat = [Preferred_Dropoff_Time]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Owner_Digital_Signature
			(
    			type = signature
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Section3
			(
				type = section
				displayname = "Section"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Insurance_Copy_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section4
			(
				type = section
				displayname = "Section"
	 			row = 6
	 			column = 0   
				width = medium
			)
			Engine_Sound_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Section5
			(
				type = section
				displayname = "Section"
	 			row = 7
	 			column = 0   
				width = medium
			)
			Vehicle_Issue_Video
			(
    			type = video
    			duration=30
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section6
			(
				type = section
				displayname = "Section"
	 			row = 8
	 			column = 0   
				width = medium
			)
			Service_Request_ID
			(
    			type = autonumber
				start index = 1
	 			row = 8
	 			column = 1   
				width = medium
			)
			Section7
			(
				type = section
				displayname = "Section"
	 			row = 9
	 			column = 0   
				width = medium
			)
			Net_Service_Cost_Payable
			(
				type = decimal
	 			row = 9
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Vehicle_Age_Years * input.Estimated_Service_Cost
    						visibility = false
    			)
			)
			Section8
			(
				type = section
				displayname = "Section"
	 			row = 10
	 			column = 0   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Service_Tracking_QR_Code"
				value = "${Vehicle_Registration_Number}"
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Requested","In Diagnosis","In Repair","Ready for Pickup","Requeste","completed"}
			}
		}
	}
	reports
	{
		default list VEHICLE_SERVICE_BOOKING_Report
		{
			displayName = "VEHICLE SERVICE BOOKING Report"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
		}
		list All_Service_Requests_List1
		{
			displayName = "All_Service_Requests_List"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
		}
		spreadsheet Service_Requests_Spreadsheet
		{
			displayName = "Service_Requests_Spreadsheet"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
		}
		kanban Service_Status_Kanban
		{
			displayName = "Service_Status_Kanban"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
			options
			(
	 			display field = Service_Type
				sort order  = ascending
	 		)
		}
		calendar Service_Schedule_Calendar
		{
			displayName = "Service_Schedule_Calendar"
			show all rows from Service_Request_Form    
			(
				Owner_Digital_Signature
				Vehicle_Type
				Owner_Name 
				Preferred_Dropoff_Time
				Preferred_Service_Date
				Odometer_Reading
				Vehicle_Issue_Video
				Service_Type
				Engine_Sound_Voice_Note
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Insurance_Copy_Upload
				Additional_Services_Requested
				Net_Service_Cost_Payable
				Service_Request_ID
				QR_Code as "Service_Tracking_QR_Code"
				Vehicle_Damage_Photo
				Insurance_Policy_Portal_URL
				Authorize_Estimate_And_Repair
				Service_Center_Guidelines_Display
				Requires_Pickup_Drop_Service
				Email_Address
				Service_Request_Submitted_On
				Vehicle_Age_Years
				Estimated_Service_Cost
				Service_Discount_Percent
				Vehicle_Model_Lookup
				Issue_Description
				Vehicle_Registration_Number
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Added_Time as "Added Time"
			)
			options
			(
				display field = Preferred_Service_Date
				start date = Added_Time
				end date = Preferred_Service_Date
			)
		}
		map Owner_Location_Map
		{
			displayName = "Owner_Location_Map"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
			options
			(
	 			display field = Pickup_Address
	 		)
		}
		timeline Service_Activity_Timeline
		{
			displayName = "Service_Activity_Timeline"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Email_Address
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Service_Request_Submitted_On
				Vehicle_Model_Lookup
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "Service_Tracking_QR_Code"
			)
			options
			(
				display field = Service_Request_Submitted_On
				start date = Preferred_Service_Date
				end date = Service_Request_Submitted_On
			)
		}
	}
	pages
	{
		page Service_Command_Center_Page
		{
			displayname = "Service_Command_Center_Page."
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<search \n\telementName='Vehicle_Owner_Search_Bar'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'flat'\n\tresultComponent = 'report'\n\tlinkName = 'All_Service_Requests_List1'\n\ttarget = 'new-window'\n\tcriteriaString = 'Additional_Services_Requested == input.searchString'\n\tfontFamily = 'default'\n\tappLinkName = 'thisapp'\n\tstyle = '1'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Command_Center_Main_Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Service_Request_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'New services received'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'